{
  "expo": {
    "name": "Recite",
    "slug": "Recite",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icons/icon.png",
    "scheme": "recite",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icons/icon.png",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "versionCode": 2,
      "icon": "./assets/images/icons/icon.png",
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.munnawar.Recite"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icons/icon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9b47bea5-b465-41da-bfaf-cc28e2c37dcc"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F1EA",
          "image": "./assets/images/icons/splash.png",
          "imageWidth": 200,  
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#121415",
            "image": "./assets/images/icons/splash.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableAudioRecording": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-file-system",
      "expo-asset",
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sfx/notification.mp3"]
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-sharing",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b47bea5-b465-41da-bfaf-cc28e2c37dcc"
      }
    }
  }
}
