{
  "expo": {
    "name": "Recite",
    "slug": "Recite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icons/icon.png",
    "scheme": "recite",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icons/icon.png"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2A5941",
        "foregroundImage": "./assets/images/icons/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ],
      "package": "com.munnawar.Recite"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icons/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121415",
          "image": "./assets/images/icons/icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-audio",
        {
          "enableAudioRecording": false
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icons/adaptive-icon.png",
          "color": "#2A5941",
          "sounds": [
            "./assets/sfx/notification.mp3"
          ]
        }
      ],
      "expo-file-system",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b47bea5-b465-41da-bfaf-cc28e2c37dcc"
      }
    }
  }
}
